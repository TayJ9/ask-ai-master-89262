{
  "name": "ai-interview-coach",
  "version": "1.0.0",
  "description": "AI Interview Coach - Full Stack Application",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "install:all": "npm install",
    "screenshots:before": "node scripts/capture-ui-screenshots.mjs",
    "test:transcript": "npm run test:transcript --workspace=frontend"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.6.2",
    "drizzle-kit": "^0.31.7",
    "playwright": "^1.51.1",
    "ws": "^8.18.0"
  }
}
