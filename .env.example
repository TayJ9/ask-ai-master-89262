# Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git - it contains sensitive secrets

# ============================================
# BACKEND CONFIGURATION
# ============================================

# OpenAI API Key (REQUIRED for voice interviews and AI features)
# Get your API key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# JWT Secret (REQUIRED for authentication)
# Railway may block the name JWT_SECRET — use AUTH_JWT_SECRET there instead.
# Generate: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here
# AUTH_JWT_SECRET=your_jwt_secret_here

# Database URL (REQUIRED - PostgreSQL in production)
DATABASE_URL=postgresql://user:password@host:port/database

# Server Port (Optional - Coolify/Railway set this automatically)
PORT=5000

# Node Environment
NODE_ENV=production

# Frontend URL (REQUIRED in production for CORS — Coolify unified deploy)
FRONTEND_URL=https://mockly.yourdomain.com

# ============================================
# EMAIL (Resend — verification + results emails)
# ============================================
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Mockly <noreply@yourdomain.com>

# ============================================
# ACCESS GATE (Production — hourly codes, UTC)
# ============================================
# Unset ACCESS_GATE_SECRET in local dev to disable the gate.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_GATE_SECRET=your_access_gate_secret_here
ACCESS_GATE_ADMIN_KEY=your_admin_key_for_operator_endpoint
# ACCESS_GATE_COOKIE_MAX_AGE_SECONDS=604800
# ALLOW_SIGNUP=true
# ALLOW_VERCEL_ORIGINS=false

# Reverse proxy hops (Coolify / Traefik)
# TRUST_PROXY_HOPS=1

# ============================================
# ARIZE OBSERVABILITY (Optional — scoring pipeline)
# ============================================
# ARIZE_SPACE_ID=your_arize_space_id
# ARIZE_API_KEY=your_arize_api_key
# ARIZE_PROJECT_NAME=mockly-scoring
# ARIZE_OTLP_URL=https://otlp.arize.com/v1/traces

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# Coolify unified deploy: leave VITE_API_URL unset (same-origin relative URLs).
# Split Vercel + Railway deploy only:
# VITE_API_URL=https://your-backend-url.example.com

# Supabase Configuration (if using Supabase)
# VITE_SUPABASE_URL=your_supabase_url_here
# VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# VITE_SUPABASE_PROJECT_ID=your_supabase_project_id_here

# ============================================
# LOCAL DEV ONLY — seed test login (backend/)
# ============================================
# Run from backend/: npm run create-test-user
# DEV_TEST_EMAIL=dev@localhost.test
# DEV_TEST_FULL_NAME=Local Dev User
# DEV_TEST_PASSWORD=your_local_password_min_8_chars

# ============================================
# PRODUCTION USER SCRIPT (invite-only mode)
# ============================================
# CREATE_USER_CONFIRM=1
# PROD_USER_EMAIL=invitee@example.com
# PROD_USER_PASSWORD=secure_password_here
# PROD_USER_FULL_NAME=Invitee Name
